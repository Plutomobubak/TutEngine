scene {
    entity Player {
        Transform(position: [0, 1, 0], rotation: [0, 0, 0], scale: [1, 1, 1]);
        Collider(type:"box",size: [1,2,1],debug:true,group:2,mask:5);
        Script(src: "Player");
      } 
    entity PlayerGroundcheck{
      Transform(position:[0,-0.8,0]);
      Parent(parent:"Player");
      Collider(type:"box",size: [1,0.4,1],debug:true,group:16,mask:1);
    }
    use TutelCharacter {
        Transform(position: [1, 0, -2]);
    }
    use TutelCharacter {
        Transform(position: [0, 0, 0], rotation: [0,3.14,0]);
        Parent(parent:"Player");
    }
    entity Cam {
        Transform(position: [0, 2, 2], rotation: [-0.5,0,0]);
        Camera();
        Parent(parent:"Player");
    }
    entity Ground {
        Transform();
